# 后端环境变量示例（复制为 .env 后修改；.env 已被 .gitignore 忽略，切勿提交到仓库）
# 生产部署通过环境变量注入，密钥绝不写入代码或配置文件。

# JWT 签名密钥（生产必填，≥32 字节随机字符串，可用 `openssl rand -base64 48` 生成）
APP_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# JWT 过期时间（毫秒，默认 24 小时）
APP_JWT_EXPIRATION=86400000

# 允许的前端跨域来源（多个用逗号分隔；开发期可用 *，生产请改为真实域名）
APP_CORS_ORIGINS=*

# 数据库：默认 H2 内存（开箱即用）；生产推荐 PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/colorai
DB_USERNAME=colorai
DB_PASSWORD=changeme_strong_password

# 可选：大模型顾问（不配置则使用内置规则引擎，功能完整可用）
APP_LLM_ENABLED=false
APP_LLM_BASE_URL=https://api.openai.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=gpt-4o-mini
